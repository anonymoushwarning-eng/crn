# --- Turso (remote SQLite) -------------------------------------------------
# The app uses the local file database `data/crn.db` unless TURSO_AUTH_TOKEN is
# set. On Vercel, add TURSO_AUTH_TOKEN in Project → Settings → Environment
# Variables so the deployed app talks to Turso instead of the ephemeral disk.
# Create a token with:  turso db tokens create crn
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- Vercel Blob (uploaded images) -----------------------------------------
# Automatically provided when a Blob store is connected to the Vercel project.
# Locally, leave this empty to store images on disk in data/images/.
BLOB_READ_WRITE_TOKEN=""
