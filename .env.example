# --- Turso (remote SQLite) -------------------------------------------------
# The app uses the local file database `data/crn.db` unless TURSO_AUTH_TOKEN is
# set. On Vercel, add TURSO_AUTH_TOKEN in Project → Settings → Environment
# Variables so the deployed app talks to Turso instead of the ephemeral disk.
# Create a token with:  turso db tokens create crn
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- Vercel Blob (uploaded images & videos) --------------------------------
# Automatically configured when a Blob store is connected to the Vercel project:
# either BLOB_READ_WRITE_TOKEN, or OIDC credentials (BLOB_STORE_ID +
# VERCEL_OIDC_TOKEN). Locally, leave these empty to store media on disk in
# data/images/. The store must be created with PUBLIC access.
#
# IMPORTANT: OIDC alone cannot sign browser upload tokens. Large videos are
# uploaded straight from the browser to Blob (to bypass the serverless ~4.5 MB
# request-body limit), and that flow needs the static read-write token below.
# Set BLOB_READ_WRITE_TOKEN for ALL environments (Production, Preview,
# Development), or large video uploads will fail.
BLOB_READ_WRITE_TOKEN=""
